# cp .env.example .env
# Spring Boot는 .env를 자동으로 읽지 않는다. 셸에 export 하거나 IDE 실행 구성에 넣는다.
# 지정하지 않으면 application.yaml의 기본값(로컬 compose 설정)이 쓰인다.

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=gitit
MONGODB_USERNAME=gitit
MONGODB_PASSWORD=gitit1234

# JWT
JWT_SECRET=verylongsecretkeyfordevelopmentenvironmentonly

# OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_ID=