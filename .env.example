# cp .env.example .env
# Spring Boot는 .env를 자동으로 읽지 않는다. 셸에 export 하거나 IDE 실행 구성에 넣는다.

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=gitit
MONGODB_USERNAME=gitit
MONGODB_PASSWORD=gitit1234

# JWT
JWT_SECRET=

# OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_ID=

# 레포를 내려받아 푸는 디렉터리. 컨테이너는 uid 1000으로 도는데 이미지 파일시스템은 root 소유라,
# /tmp 밖을 넣으려면 그 경로를 uid 1000이 쓸 수 있게 만들어 둬야 한다. 예: /tmp/gitit-work
#
# 이름에 GITHUB_ 접두사를 붙이지 않는다 — Actions가 그 접두사로 시작하는 시크릿을 거부해서
# 워크플로에서 빈 문자열로 치환되고, 작업 공간이 조용히 프로세스 작업 디렉터리가 된다.
WORK_DIR=
# github 토큰
GH_TOKEN=

# GitHub
# 공개 레포 읽기 전용 PAT. 없으면 무인증(시간당 60회)으로 돈다.
# 이름에 GITHUB_ 접두사를 붙이지 않는다 — Actions가 그 접두사로 시작하는 시크릿을 거부한다.
GH_TOKEN=

# Gemini (Vertex AI)
GCP_CREDENTIALS_BASE64=
